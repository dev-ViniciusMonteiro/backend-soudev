{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backend-soudev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Sites que podem abrir conexão (separados por vírgula).
    "ORIGENS": "https://soudev.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:4173"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SALA", "class_name": "Sala" },
      { "name": "DIRETORIO", "class_name": "Diretorio" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala", "Diretorio"] }]
}
